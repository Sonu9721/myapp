# Core application
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./leads.db
FRONTEND_ORIGINS=http://localhost:3000

# OpenAI Responses API (required for live AI analysis and generation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_SECONDS=120

# Official Google Places API (New). Enable Places API in Google Cloud first.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_LANGUAGE=en
GOOGLE_PLACES_REGION=IN
GOOGLE_PLACES_CACHE_TTL_HOURS=24

# Automation limits. One task = one location x one niche keyword.
MAX_RESULTS_PER_QUERY=20
MAX_CAMPAIGN_TASKS=5000
MAX_CONCURRENT_LEADS=3
WEBSITE_ENRICHMENT_ENABLED=true
WEBSITE_TIMEOUT_SECONDS=10

# Outreach is draft-only by default. Production sending also requires campaign approval.
OUTREACH_MODE=draft
MAX_OUTREACH_PER_RUN=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
